{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "title": "Engine concept manifest (M0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept",
    "parent_concept",
    "date",
    "summary",
    "modules"
  ],
  "properties": {
    "concept": {
      "$ref": "#/$defs/concept"
    },
    "parent_concept": {
      "oneOf": [
        {
          "$ref": "#/$defs/concept"
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "object",
      "propertyNames": {
        "pattern": "^M[0-9]$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^rev[0-9]{3}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "minProperties": 1,
      "description": "Active revision per module; null = module not started."
    }
  },
  "$defs": {
    "concept": {
      "type": "string",
      "pattern": "^concept[0-9]{3}$"
    }
  }
}
